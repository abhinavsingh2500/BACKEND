<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>
    <link rel="stylesheet" href="/stylesheet/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="w-full min-h-screen bg-zinc-950 p-8 text-white">
    <div class="max-w-7xl mx-auto">
        <header class="mb-8 flex items-center justify-between">
            <div>
                <p class="text-sm text-zinc-400 mb-2">Dashboard</p>
                <h1 class="text-4xl font-bold tracking-tight">All Users</h1>
            </div>
            <a href="/" class="text-blue-500 hover:text-blue-400 font-semibold">Back to Create User</a>
        </header>

        <% if (users && users.length) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                <% users.forEach(function(user) { %>
                    <div class="bg-zinc-800 rounded-3xl p-6 shadow-xl shadow-black/20 hover:bg-zinc-700 transition duration-200">
                        <div class="w-full h-44 bg-zinc-700 rounded-3xl mb-5 overflow-hidden">
                            <% if (user.image) { %>
                                <img src="<%= user.image %>" alt="<%= user.username %>" class="w-full h-full object-cover" />
                            <% } else { %>
                                <div class="w-full h-full flex items-center justify-center text-zinc-500">No image</div>
                            <% } %>
                        </div>
                        <h3 class="text-xl font-semibold mb-2"><%= user.username %></h3>
                        <p class="text-zinc-400 text-sm mb-4 break-words"><%= user.email %></p>
                        <div class="flex gap-3">
                            <a href="/edit/<%= user._id %>" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold py-3 rounded-xl text-center transition">Edit</a>
                            <a href="/delete/<%= user._id %>" class="flex-1 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold py-3 rounded-xl text-center transition">Delete</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="rounded-3xl bg-zinc-800 p-10 text-center">
                <p class="text-zinc-300">No users found yet. Create one from the dashboard.</p>
            </div>
        <% } %>
    </div>
</body>
</html>
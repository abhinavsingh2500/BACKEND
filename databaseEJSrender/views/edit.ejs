<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Database EJS Render</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="w-full h-full bg-zinc-900 text-white flex items-center justify-center p-10">
    <div class="w-full max-w-md bg-zinc-800 rounded-lg p-8">
        <header class="mb-8">
           <a class="text-blue-500 hover:text-blue-700 font-semibold" href="/read">USER DASHBOARD</a>
        </header>

        <main>
            <h2 class="text-2xl font-bold mb-6">Update User</h2>
            <form action="/update/<%= user._id %>" method="POST" class="space-y-4">
                <label class="block">
                    <span class="text-zinc-300 text-sm font-medium mb-1 block">Username</span>
                    <input class="w-full px-4 py-2 bg-zinc-700 border border-zinc-600 text-white rounded hover:border-zinc-500 focus:outline-none focus:border-blue-500" type="text" name="username" value="<%= user.username %>" placeholder="Enter username" required>
                </label>
                <label class="block">
                    <span class="text-zinc-300 text-sm font-medium mb-1 block">Email</span>
                    <input class="w-full px-4 py-2 bg-zinc-700 border border-zinc-600 text-white rounded hover:border-zinc-500 focus:outline-none focus:border-blue-500" type="email" name="email" value="<%= user.email %>" placeholder="Enter email" required>
                </label>
                <label class="block">
                    <span class="text-zinc-300 text-sm font-medium mb-1 block">Image URL</span>
                    <input class="w-full px-4 py-2 bg-zinc-700 border border-zinc-600 text-white rounded hover:border-zinc-500 focus:outline-none focus:border-blue-500" type="text" name="image" value="<%= user.image %>" placeholder="image url" required>
                </label>
                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded transition mt-6">Update User</button>
            </form>
        </main>
    </div>
</body>
</html>
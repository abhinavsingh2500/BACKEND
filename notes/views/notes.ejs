<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NOTES</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/stylesheets/notes.css">
</head>
<body>
    <script src="/script/notes.js"></script>
    <div class="main w-full min-h-screen bg-gray-300">
        <div class="form p-10 text-white">
            <form action="/add-note" method="POST">
                <input name="title" class="block w-full rounded-md outline-none px-3 py-5 text-black border border-black mb-5 text-sm" type="text" placeholder="Title" required>
                <textarea name="content" class="block w-full rounded-md outline-none px-3 py-2 text-black border border-black text-sm" rows="10" required></textarea>
                <input class="mt-2 bg-blue-600 px-4 py-2 text-black rounded-md cursor-pointer" type="submit" value="Add Note">
            </form>
        </div>
        
        <div class="tasks mt-10 flex gap-5 flex-wrap rounded-md p-10">
            <% if (documents && documents.length > 0) { %>
                <% documents.forEach(function(doc) { %>
                    <div class="task w-72 px-3 py-4 bg-gray-300 border border-black rounded-md">
                        <h1 class="text-white text-xl tracking-tighter"><%= doc %></h1>
                        <a href="/notes/<%= doc %>" class="text-blue-600 hover:text-blue-800 inline-block mt-2">read more.</a>
                    </div>
                <% }) %>
            <% } else { %>
                <h3 class="text-red-500">No tasks here</h3>
            <% } %>
        </div>
    </div>
</body>
</html>

    
</body>
</html>